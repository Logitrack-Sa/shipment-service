              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{gatewayUrl}}/api/v1/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"client-{{runId}}@example.test\",\n  \"password\": \"{{demoUserPassword}}\",\n  \"roles\": [\n    \"CLIENTE\"\n  ],\n  \"customerId\": \"{{customerId}}\"\n}",
              "options": {
