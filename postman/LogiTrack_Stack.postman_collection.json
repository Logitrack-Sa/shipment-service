{
  "info": {
    "name": "LogiTrack - Sprint 3 - Gateway real",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar carpetas en orden. Usa el Gateway para security, shipment y courier; genera datos únicos y obtiene JWT reales. Credenciales solo en un entorno privado; los tokens se mantienen en memoria durante la ejecución."
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "gatewayUrl",
      "value": "http://localhost:8066",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "00 - Salud y preparación",
      "item": [
        {
          "name": "Gateway saludable",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gatewayUrl}}/actuator/health"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "[\"adminToken\",\"clientToken\",\"courierToken\",\"customerId\",\"courierId\",\"shipmentId\"].forEach(function (key) { pm.collectionVariables.unset(key); });",
                  "pm.collectionVariables.set(\"runId\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.collectionVariables.set(\"courierDni\", String(10000000 + parseInt(pm.collectionVariables.get(\"runId\").replace(/-/g, \"\").slice(0, 10), 16) % 90000000));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Estado UP\", function () { pm.expect(pm.response.json().status).to.eql(\"UP\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Autenticación ADMIN",
      "item": [
        {
          "name": "Login ADMIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gatewayUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) { const token = pm.response.json().accessToken; pm.test(\"JWT recibido\", function () { pm.expect(typeof token).to.eql(\"string\"); }); pm.collectionVariables.set(\"adminToken\", token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Perfil ADMIN en security",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{gatewayUrl}}/api/v1/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Datos y asignación",
      "item": [
        {
          "name": "Crear cliente en shipment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{gatewayUrl}}/api/v1/customers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Sprint3 {{runId}}\",\n  \"email\": \"customer-{{runId}}@example.test\",\n  \"phone\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) { pm.collectionVariables.set(\"customerId\", pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear repartidor con DNI",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{gatewayUrl}}/api/v1/couriers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Sprint3 {{runId}}\",\n  \"dni\": \"{{courierDni}}\",\n  \"vehicleType\": \"MOTO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) { pm.collectionVariables.set(\"courierId\", pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear envío",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{gatewayUrl}}/api/v1/shipments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"origin\": {\n    \"street\": \"Bolivia\",\n    \"number\": \"1239\",\n    \"city\": \"Jujuy\",\n    \"postalCode\": \"4600\"\n  },\n  \"destination\": {\n    \"street\": \"Bolivia\",\n    \"number\": \"1239\",\n    \"city\": \"Jujuy\",\n    \"postalCode\": \"4600\"\n  },\n  \"weightKg\": 2.5,\n  \"widthCm\": 30,\n  \"heightCm\": 20,\n  \"lengthCm\": 40\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) { pm.collectionVariables.set(\"shipmentId\", pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Asignar por Feign y Eureka",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{gatewayUrl}}/api/v1/shipments/{{shipmentId}}/courier",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courierId\": \"{{courierId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Repartidor asignado\", function () { pm.expect(pm.response.json().courierId).to.eql(pm.collectionVariables.get(\"courierId\")); });"
                ]
              }
            }
          ]
        }
      ]
    },
