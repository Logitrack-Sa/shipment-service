                {
                  "key": "token",
                  "value": "{{courierToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{gatewayUrl}}/api/v1/shipments/{{shipmentId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ENTREGADO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Historial completo",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{gatewayUrl}}/api/v1/shipments/{{shipmentId}}/history"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Transiciones registradas\", function () { pm.expect(pm.response.json().map(function (event) { return event.newStatus; })).to.eql([\"PENDIENTE\",\"EN_RUTA\",\"ENTREGADO\"]); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "07 - CORS",
      "item": [
        {
          "name": "Preflight de origen permitido",
          "request": {
            "method": "OPTIONS",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{corsOrigin}}"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "GET"
              },
              {
                "key": "Access-Control-Request-Headers",
                "value": "authorization"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gatewayUrl}}/api/v1/shipments"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Origen permitido\", function () { pm.expect(pm.response.headers.get(\"Access-Control-Allow-Origin\")).to.eql(pm.environment.get(\"corsOrigin\")); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Preflight de origen rechazado",
          "request": {
            "method": "OPTIONS",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "https://untrusted.example.test"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "GET"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{gatewayUrl}}/api/v1/shipments"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
